% neurips_2026.sty --- NeurIPS-style formatting.
%
% HONEST LABELLING, because it matters for a submission: this is a
% reimplementation of the NeurIPS layout written for this repository, not the
% official style file distributed by the conference. It reproduces the
% measurements a reader recognises -- 5.5in text column, 9in height, Times at
% 10pt, the small-caps section headings, the ruled abstract, numbered lines in
% preprint mode -- so the paper drafts and reviews at the right length.
%
% Before submitting anywhere, replace this file with the official one for that
% venue and rebuild. The document body needs no changes; it uses only the
% \author/\And/\AND macros and the [preprint]/[final] options the real style
% provides.
%
% Options:
%   preprint  numbered lines, author names shown (default)
%   final     no line numbers, author names shown
%   nonatbib  do not load natbib

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{neurips_2026}[2026/08/08 NeurIPS-style layout (unofficial)]

\newif\if@neuripspreprint \@neuripspreprinttrue
\newif\if@neuripsnatbib   \@neuripsnatbibtrue

\DeclareOption{preprint}{\@neuripspreprinttrue}
\DeclareOption{final}{\@neuripspreprintfalse}
\DeclareOption{nonatbib}{\@neuripsnatbibfalse}
\ProcessOptions\relax

\RequirePackage{geometry}
\RequirePackage{fancyhdr}

% ---------------------------------------------------------------- page layout
\geometry{
  letterpaper,
  textwidth=5.5in,
  textheight=9.0in,
  top=1.0in,
  left=1.5in,
  headheight=12pt,
  headsep=25pt,
  footskip=30pt
}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\cfoot{\thepage}

\if@neuripspreprint
  \RequirePackage[left]{lineno}
  \linenumbers
  % Line numbers and display math fight: without these patches every aligned
  % environment silently loses its numbering.
  \newcommand*\patchAmsMathEnvironmentForLineno[1]{%
    \expandafter\let\csname old#1\expandafter\endcsname\csname #1\endcsname
    \expandafter\let\csname oldend#1\expandafter\endcsname\csname end#1\endcsname
    \renewenvironment{#1}{\linenomath\csname old#1\endcsname}%
                         {\csname oldend#1\endcsname\endlinenomath}}%
  \newcommand*\patchBothAmsMathEnvironmentsForLineno[1]{%
    \patchAmsMathEnvironmentForLineno{#1}%
    \patchAmsMathEnvironmentForLineno{#1*}}%
  \AtBeginDocument{%
    \@ifpackageloaded{amsmath}{%
      \patchBothAmsMathEnvironmentsForLineno{equation}%
      \patchBothAmsMathEnvironmentsForLineno{align}%
      \patchBothAmsMathEnvironmentsForLineno{gather}%
      \patchBothAmsMathEnvironmentsForLineno{multline}%
    }{}%
  }
\fi

\if@neuripsnatbib
  \RequirePackage[numbers,sort&compress]{natbib}
  \renewcommand{\bibsection}{\subsubsection*{\bibname}}
  \newcommand{\bibname}{References}
\fi

% ------------------------------------------------------------------ typeface
\RequirePackage{times}
\renewcommand{\rmdefault}{ptm}
\renewcommand{\normalsize}{\fontsize{10}{12}\selectfont}
\normalsize

% --------------------------------------------------------------- title block
\renewcommand{\maketitle}{%
  \par
  \begingroup
    \setlength{\parindent}{0pt}%
    \vspace*{-0.4in}%
    {\centering
      {\LARGE\bfseries \@title \par}%
      \vskip 0.30in
      {\large \@author \par}%
      \vskip 0.25in
    }%
  \endgroup
  \thispagestyle{fancy}%
  \@thanks
  \setcounter{footnote}{0}%
}

% Author separators, matching the official macros so the body is portable.
\newcommand{\And}{\hspace{0.25in}}
\newcommand{\AND}{\\[0.10in]}

% ------------------------------------------------------------------- abstract
\renewenvironment{abstract}{%
  \centerline{\large\bfseries Abstract}%
  \vspace{0.5ex}%
  \begin{quote}\small
}{%
  \end{quote}%
  \vspace{1ex}%
}

% ------------------------------------------------------------------- headings
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{2.0ex plus 0.6ex minus 0.2ex}{1.0ex plus 0.2ex}
\titlespacing*{\subsection}{0pt}{1.6ex plus 0.5ex minus 0.2ex}{0.8ex plus 0.2ex}
\titlespacing*{\subsubsection}{0pt}{1.2ex plus 0.4ex minus 0.2ex}{0.6ex plus 0.2ex}

% --------------------------------------------------------------------- floats
\setlength{\textfloatsep}{14pt plus 2pt minus 3pt}
\setlength{\floatsep}{12pt plus 2pt minus 2pt}
\setlength{\intextsep}{12pt plus 2pt minus 2pt}
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.7}

\endinput
